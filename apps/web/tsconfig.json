{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // "node" is needed only because the tRPC router type (from @app/api) references Node APIs.
    "types": ["vite/client", "node"],
    // "@/x" is apps/web/src/x (also set in vite.config.ts and vitest.config.ts).
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "test", "vite.config.ts"]
}
